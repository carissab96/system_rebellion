# System Rebellion Production Environment Variables
# Copy this to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://username:password@hostname:port/database_name

# Security Keys (Generate strong random keys for production)
SECRET_KEY=your-super-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS=https://your-frontend-domain.onrender.com

# Application Settings
ENVIRONMENT=production
DEBUG=false

# Render API Configuration
RENDER_API_KEY=rnd_NARPNO8QFcWs8Zijmn3XcP5hwtkl

# Optional: Email Configuration (for future features)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Optional: Redis Configuration (for caching/sessions)
# REDIS_URL=redis://localhost:6379
