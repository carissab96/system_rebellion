#!/bin/bash
#
# hamster-package-cache-clean - Safe package cache cleanup wrapper
#
# This script cleans package manager caches (apt, yum, dnf, pacman).
# Detects the system's package manager and cleans appropriately.
#
# Usage: hamster-package-cache-clean
#
# Safety features:
# - Only operates on package manager caches
# - Detects package manager automatically
# - Preserves currently installed packages
# - Full logging
#
# NO FAKE DATA. NO SHORTCUTS. TRUTH OR GRACEFUL FAILURE.

set -euo pipefail

# Load common library
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/hamster-common.sh"

# Configuration
HAMSTER="CARL"  # Carl handles package management (quantum precision)
OPERATION="package-cache-clean"

# Initialize
init_hamster_script "hamster-package-cache-clean" "$HAMSTER"

# Detect package manager
detect_package_manager() {
    if command_exists apt-get; then
        echo "apt"
    elif command_exists yum; then
        echo "yum"
    elif command_exists dnf; then
        echo "dnf"
    elif command_exists pacman; then
        echo "pacman"
    elif command_exists zypper; then
        echo "zypper"
    else
        echo "unknown"
    fi
}

PKG_MANAGER=$(detect_package_manager)

if [[ "$PKG_MANAGER" == "unknown" ]]; then
    log_action "$HAMSTER" "ERROR" "No supported package manager found"
    exit 1
fi

log_action "$HAMSTER" "INFO" "Detected package manager: $PKG_MANAGER"

# Get cache size before cleanup
get_cache_size() {
    local cache_path=$1
    if [[ -d "$cache_path" ]]; then
        du -sh "$cache_path" 2>/dev/null | awk '{print $1}' || echo "unknown"
    else
        echo "0"
    fi
}

EXIT_CODE=0

case "$PKG_MANAGER" in
    apt)
        CACHE_PATH="/var/cache/apt/archives"
        SIZE_BEFORE=$(get_cache_size "$CACHE_PATH")
        
        log_action "$HAMSTER" "INFO" "Cleaning apt cache (current size: $SIZE_BEFORE)"
        
        if apt-get clean 2>&1 | tee -a "$STICK_LOG"; then
            SIZE_AFTER=$(get_cache_size "$CACHE_PATH")
            log_action "$HAMSTER" "INFO" "apt cache cleaned: $SIZE_BEFORE -> $SIZE_AFTER"
        else
            log_action "$HAMSTER" "ERROR" "apt-get clean failed"
            EXIT_CODE=1
        fi
        ;;
        
    yum)
        log_action "$HAMSTER" "INFO" "Cleaning yum cache"
        
        if yum clean all 2>&1 | tee -a "$STICK_LOG"; then
            log_action "$HAMSTER" "INFO" "yum cache cleaned successfully"
        else
            log_action "$HAMSTER" "ERROR" "yum clean failed"
            EXIT_CODE=1
        fi
        ;;
        
    dnf)
        log_action "$HAMSTER" "INFO" "Cleaning dnf cache"
        
        if dnf clean all 2>&1 | tee -a "$STICK_LOG"; then
            log_action "$HAMSTER" "INFO" "dnf cache cleaned successfully"
        else
            log_action "$HAMSTER" "ERROR" "dnf clean failed"
            EXIT_CODE=1
        fi
        ;;
        
    pacman)
        CACHE_PATH="/var/cache/pacman/pkg"
        SIZE_BEFORE=$(get_cache_size "$CACHE_PATH")
        
        log_action "$HAMSTER" "INFO" "Cleaning pacman cache (current size: $SIZE_BEFORE)"
        
        # Keep only the most recent version of each package
        if pacman -Sc --noconfirm 2>&1 | tee -a "$STICK_LOG"; then
            SIZE_AFTER=$(get_cache_size "$CACHE_PATH")
            log_action "$HAMSTER" "INFO" "pacman cache cleaned: $SIZE_BEFORE -> $SIZE_AFTER"
        else
            log_action "$HAMSTER" "ERROR" "pacman -Sc failed"
            EXIT_CODE=1
        fi
        ;;
        
    zypper)
        log_action "$HAMSTER" "INFO" "Cleaning zypper cache"
        
        if zypper clean --all 2>&1 | tee -a "$STICK_LOG"; then
            log_action "$HAMSTER" "INFO" "zypper cache cleaned successfully"
        else
            log_action "$HAMSTER" "ERROR" "zypper clean failed"
            EXIT_CODE=1
        fi
        ;;
esac

# Finalize
finalize_hamster_script "hamster-package-cache-clean" "$HAMSTER" $EXIT_CODE

exit $EXIT_CODE
